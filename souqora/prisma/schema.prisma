datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ──────────────────────────────────────────────
// USER & AUTHENTICATION
// ──────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  SELLER
  VERIFIED_SELLER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

model User {
  id            String      @id @default(uuid())
  email         String      @unique
  passwordHash  String?
  name          String
  phone         String?
  role          UserRole    @default(CUSTOMER)
  status        UserStatus  @default(ACTIVE)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  sellerProfile SellerProfile?
  accounts      Account[]
  sessions      Session[]
  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  favorites     Favorite[]
  auditLogs     AuditLog[]
  inquiriesSent ListingInquiry[] @relation("BuyerInquiries")

  @@index([role])
  @@index([status])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ──────────────────────────────────────────────
// SELLER & STORES
// ──────────────────────────────────────────────

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

model SellerProfile {
  id                         String             @id @default(uuid())
  userId                     String             @unique
  storeName                  String
  storeNameEn                String?
  storeSlug                  String             @unique
  description                String?            @db.Text
  descriptionEn              String?            @db.Text
  logoUrl                    String?
  coverImageUrl              String?
  verificationStatus         VerificationStatus @default(PENDING)
  verificationNotes          String?            @db.Text
  businessRegistrationNumber String?
  taxNumber                  String?
  allowedCategories          Json?              // Array of Category slugs permitted
  country                    String             @default("SA")
  city                       String?
  addressLine                String?
  commissionRateOverride     Float?             // Optional custom commission %
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  products          Product[]
  propertyListings  PropertyListing[]
  vehicleListings   VehicleListing[]
  orderItems        OrderItem[]
  payouts           SellerPayout[]
  inquiriesReceived ListingInquiry[]   @relation("SellerInquiries")

  @@index([verificationStatus])
  @@index([storeSlug])
}

// ──────────────────────────────────────────────
// CATEGORIES & ATTRIBUTES
// ──────────────────────────────────────────────

enum ListingType {
  CART
  INQUIRY
  RESTRICTED
}

model Category {
  id            String      @id @default(uuid())
  slug          String      @unique
  name          String
  nameEn        String
  description   String?     @db.Text
  descriptionEn String?     @db.Text
  icon          String      @default("Package")
  listingType   ListingType @default(CART)
  parentId      String?
  sortOrder     Int         @default(0)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  parent   Category?  @relation("SubCategories", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("SubCategories")
  products Product[]

  @@index([slug])
  @@index([parentId])
}

// ──────────────────────────────────────────────
// PRODUCTS & INVENTORY (Cart Workflow)
// ──────────────────────────────────────────────

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  SUSPENDED
  ARCHIVED
}

model Product {
  id                   String        @id @default(uuid())
  sellerId             String
  categoryId           String
  slug                 String        @unique
  title                String
  titleEn              String?
  description          String        @db.Text
  descriptionEn        String?       @db.Text
  priceAmount          Int           // Minor currency units (e.g., 29900 = 299.00 SAR)
  priceCurrency        String        @default("SAR")
  compareAtPriceAmount Int?          // Minor currency units
  status               ProductStatus @default(PENDING_REVIEW)
  featured             Boolean       @default(false)
  attributes           Json?         // Key-value specifications
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  seller     SellerProfile    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category   Category         @relation(fields: [categoryId], references: [id])
  variants   ProductVariant[]
  images     ProductImage[]
  reviews    Review[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  favorites  Favorite[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
  @@index([featured])
  @@index([slug])
}

model ProductVariant {
  id                   String   @id @default(uuid())
  productId            String
  sku                  String   @unique
  title                String
  priceAmount          Int      // Minor units
  compareAtPriceAmount Int?
  stockQuantity        Int      @default(0)
  attributes           Json?    // e.g. {"size": "XL", "color": "Blue"}
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@index([sku])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String?
  url       String
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ──────────────────────────────────────────────
// REAL ESTATE (Inquiry Workflow)
// ──────────────────────────────────────────────

enum PropertyType {
  APARTMENT
  VILLA
  HOUSE
  LAND
  COMMERCIAL
  OFFICE
}

enum PropertyListingMode {
  SALE
  RENT
}

enum PricePeriod {
  MONTHLY
  YEARLY
}

model PropertyListing {
  id            String              @id @default(uuid())
  sellerId      String
  slug          String              @unique
  title         String
  titleEn       String?
  description   String              @db.Text
  descriptionEn String?             @db.Text
  propertyType  PropertyType
  listingMode   PropertyListingMode
  priceAmount   BigInt              // Minor currency units
  priceCurrency String              @default("SAR")
  pricePeriod   PricePeriod?
  location      String
  city          String
  country       String              @default("SA")
  area          Float               // Square meters
  bedrooms      Int?
  bathrooms     Int?
  furnished     Boolean             @default(false)
  features      Json?               // Array of feature strings
  status        ProductStatus       @default(PENDING_REVIEW)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  seller    SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  favorites Favorite[]

  @@index([sellerId])
  @@index([propertyType])
  @@index([listingMode])
  @@index([city])
  @@index([status])
}

// ──────────────────────────────────────────────
// VEHICLES (Inquiry Workflow)
// ──────────────────────────────────────────────

enum VehicleCondition {
  NEW
  USED
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
}

enum TransmissionType {
  AUTOMATIC
  MANUAL
}

model VehicleListing {
  id             String            @id @default(uuid())
  sellerId       String
  slug           String            @unique
  title          String
  titleEn        String?
  description    String            @db.Text
  descriptionEn  String?           @db.Text
  make           String
  model          String
  year           Int
  mileage        Int?              // in kilometers
  condition      VehicleCondition
  fuelType       FuelType
  transmission   TransmissionType
  bodyType       String
  color          String?
  priceAmount    BigInt            // Minor currency units
  priceCurrency  String            @default("SAR")
  location       String
  specifications Json?             // Technical specs dictionary
  status         ProductStatus     @default(PENDING_REVIEW)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  seller    SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  favorites Favorite[]

  @@index([sellerId])
  @@index([make])
  @@index([year])
  @@index([condition])
  @@index([status])
}

// ──────────────────────────────────────────────
// INQUIRIES & LEAD GENERATION
// ──────────────────────────────────────────────

enum InquiryType {
  PROPERTY
  VEHICLE
  HEALTHCARE
}

enum InquiryStatus {
  NEW
  READ
  RESPONDED
  CLOSED
}

model ListingInquiry {
  id          String        @id @default(uuid())
  listingType InquiryType
  listingId   String
  sellerId    String
  buyerId     String?
  buyerName   String
  buyerEmail  String
  buyerPhone  String?
  message     String        @db.Text
  status      InquiryStatus @default(NEW)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  seller SellerProfile @relation("SellerInquiries", fields: [sellerId], references: [id], onDelete: Cascade)
  buyer  User?         @relation("BuyerInquiries", fields: [buyerId], references: [id], onDelete: SetNull)

  @@index([sellerId])
  @@index([buyerId])
  @@index([listingId])
  @@index([status])
}

// ──────────────────────────────────────────────
// CART & CHECKOUT
// ──────────────────────────────────────────────

model Cart {
  id        String     @id @default(uuid())
  userId    String?    @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  items CartItem[]
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([cartId, productId, variantId])
  @@index([cartId])
}

// ──────────────────────────────────────────────
// ORDERS & FINANCIAL TRANSACTIONS
// ──────────────────────────────────────────────

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

model Order {
  id                   String        @id @default(uuid())
  orderNumber          String        @unique
  customerId           String
  status               OrderStatus   @default(PENDING)
  currency             String        @default("SAR")
  subtotalAmount       Int           // Minor units
  shippingAmount       Int           @default(0)
  discountAmount       Int           @default(0)
  commissionAmount     Int           @default(0)
  totalAmount          Int           // Minor units (server calculated)
  shippingAddress      Json
  billingAddress       Json?
  paymentStatus        PaymentStatus @default(PENDING)
  paymentProvider      String?
  paymentReference     String?
  trackingNumber       String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  customer User        @relation(fields: [customerId], references: [id])
  items    OrderItem[]
  payments Payment[]
  refunds  Refund[]

  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([orderNumber])
}

model OrderItem {
  id                  String   @id @default(uuid())
  orderId             String
  sellerId            String
  productId           String
  variantId           String?
  productTitle        String   // Immutable snapshot
  variantTitle        String?  // Immutable snapshot
  unitPriceAmount     Int      // Minor units at time of order
  quantity            Int
  totalAmount         Int      // Minor units (unitPrice * quantity)
  commissionRate      Float    // Commission % snapshot (e.g. 5.0)
  commissionAmount    Int      // Minor units calculated
  sellerPayableAmount Int      // Minor units (totalAmount - commissionAmount)
  createdAt           DateTime @default(now())

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller  SellerProfile   @relation(fields: [sellerId], references: [id])
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([sellerId])
}

// ──────────────────────────────────────────────
// PAYMENTS & AUDITABLE EVENTS
// ──────────────────────────────────────────────

enum PaymentProviderType {
  STRIPE
  PAYPAL
  BANK_TRANSFER
  LOCAL_GATEWAY
}

model Payment {
  id                   String              @id @default(uuid())
  orderId              String
  provider             PaymentProviderType
  providerSessionId    String?
  transactionReference String              @unique
  amount               Int                 // Minor units
  currency             String              @default("SAR")
  status               PaymentStatus       @default(PENDING)
  idempotencyKey       String              @unique
  rawPayload           Json?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  order  Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events PaymentEvent[]
  refund Refund[]

  @@index([orderId])
  @@index([status])
  @@index([transactionReference])
}

model PaymentEvent {
  id              String   @id @default(uuid())
  paymentId       String
  eventType       String
  providerEventId String?  @unique
  status          String
  payload         Json?
  createdAt       DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([eventType])
}

model Refund {
  id               String   @id @default(uuid())
  orderId          String
  paymentId        String
  amount           Int      // Minor units
  currency         String   @default("SAR")
  reason           String?
  status           String   @default("COMPLETED")
  providerRefundId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([orderId])
  @@index([paymentId])
}

model SellerPayout {
  id                  String   @id @default(uuid())
  sellerId            String
  amount              Int      // Minor units
  currency            String   @default("SAR")
  status              String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  payoutReference     String   @unique
  bankDetailsSnapshot Json?
  completedAt         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  seller SellerProfile @relation(fields: [sellerId], references: [id])

  @@index([sellerId])
  @@index([status])
}

// ──────────────────────────────────────────────
// REVIEWS & FAVORITES & ADDRESSES
// ──────────────────────────────────────────────

model Review {
  id                 String   @id @default(uuid())
  productId          String
  userId             String
  rating             Int      // 1 to 5
  comment            String   @db.Text
  isVerifiedPurchase Boolean  @default(false)
  isApproved         Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  productId  String?
  propertyId String?
  vehicleId  String?
  createdAt  DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  product  Product?         @relation(fields: [productId], references: [id], onDelete: Cascade)
  property PropertyListing? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  vehicle  VehicleListing?  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, propertyId, vehicleId])
  @@index([userId])
}

model Address {
  id             String   @id @default(uuid())
  userId         String
  recipientName  String
  phone          String
  country        String   @default("SA")
  city           String
  district       String?
  street         String
  buildingNumber String?
  postalCode     String?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ──────────────────────────────────────────────
// AUDIT LOGS & SUBSCRIPTIONS
// ──────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String   // e.g. "SELLER_APPROVED", "PAYMENT_REFUNDED"
  entityType String   // e.g. "Order", "SellerProfile"
  entityId   String
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
}

model NewsletterSubscription {
  id        String   @id @default(uuid())
  email     String   @unique
  consent   Boolean  @default(true)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([email])
}
